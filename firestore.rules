rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Legacy: consultations
    match /users/{uid}/consultations/{doc=**} {
      allow read, write: if request.auth.uid == uid;
    }

    // App data (profile, patients, events, etc)
    match /users/{uid}/appData/{doc=**} {
      allow read, write: if request.auth.uid == uid;
    }

    // Doctors (subscription lives here)
    match /doctors/{uid} {
      allow read, write: if request.auth.uid == uid;
    }

    // Patients - CREATE sem checklist, UPDATE com checklist
    match /patients/{patientId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null
        && resource.data.nutritionistId == request.auth.uid;
    }

    // Subcoleções do paciente (exames e planos em PDF — modelo Híbrido).
    // Acesso restrito ao nutricionista dono do paciente, checando o doc pai.
    match /patients/{patientId}/{sub}/{doc=**} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/patients/$(patientId)).data.nutritionistId == request.auth.uid;
    }

    // Prescriptions - SAME PATTERN
    match /prescriptions/{prescriptionId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null
        && resource.data.nutritionistId == request.auth.uid;
    }

    // Evolution (peso, exames, notas) — séries temporais por paciente.
    // Restrito ao nutricionista dono do paciente (checa o doc pai). Seguro
    // agora que toda paciente é criada na coleção /patients/{id}.
    match /evolution/{patientId}/{collection}/{doc=**} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/patients/$(patientId)).data.nutritionistId == request.auth.uid;
    }
  }
}
